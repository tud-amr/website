---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for item in collections.all %}
{%- unless item.data.sitemap == false or item.data.hidden or item.data.redirect_to or item.url == false or item.url == "/404.html" %}
  <url><loc>{{ item.url | absolute_url }}</loc></url>
{%- endunless %}
{%- endfor %}
</urlset>
